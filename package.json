{
	"name": "n8n-nodes-ffmpeg-command",
	"version": "1.2.0-0",
	"description": "A N8N node for executing FFmpeg and FFprobe commands - no need for binary installations or custom Docker images.",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package",
		"n8n-nodes-ffmpeg-command",
		"ffmpeg",
		"ffprobe",
		"ffmpeg-command",
		"ffprobe-command",
		"n8n-ffmpeg",
		"n8n-ffprobe"
	],
	"author": {
		"name": "Hung Pham - @revolabs-io",
		"email": "info@revolabs.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/revolabs-io/n8n-nodes-ffmpeg-command.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/FfmpegCommand/FfmpegCommand.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"ffmpeg-ffprobe-static": "^6.1.2-rc.1"
	}
}
